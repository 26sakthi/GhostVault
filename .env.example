# 64 hex chars (32 bytes). Generate with:
#   python -c "import secrets;print(secrets.token_hex(32))"
VAULT_MASTER_KEY=
VAULT_DB_PATH=vault.db
VAULT_BASE_URL=http://localhost:3000
VAULT_SWEEP_INTERVAL=10
# Stretch S1: return a SHA-256 fingerprint of the secret at creation (0 = off)
VAULT_FINGERPRINT=0
